# Vercel Postgres Database Configuration
# These will be automatically provided by Vercel when you add a Postgres database
# You can also get these from your Vercel project dashboard

POSTGRES_URL="postgres://username:password@host:5432/database"
POSTGRES_PRISMA_URL="postgres://username:password@host:5432/database?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://username:password@host:5432/database"
POSTGRES_USER="username"
POSTGRES_HOST="host"
POSTGRES_PASSWORD="password"
POSTGRES_DATABASE="database"

# Note: When deploying to Vercel, these will be automatically set when you add a Postgres storage
# For local development, you can set up a local Postgres instance or use Vercel's development mode
